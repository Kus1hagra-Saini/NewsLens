# NewsLens backend — copy to .env and fill in.
# .env is git-ignored; never commit real credentials.

# --- Database (Neon) -------------------------------------------------------
# Use the `dev` branch URL locally; `prod` branch is only set on Render.
# Include ?sslmode=require for Neon.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# --- LLM (Groq) ------------------------------------------------------------
GROQ_API_KEY=
# Exact model string used for every enrich/compare call; recorded on each
# analysis_runs row for reproducibility. `llama-3.1-70b-versatile` was
# decommissioned by Groq on 2025-01-24; `llama-3.3-70b-versatile` was
# deprecated on 2026-08-16. Current Groq production tier as of Sep 2026
# includes `openai/gpt-oss-120b` (recommended default — supports the same
# response_format=json_object mode that enrich.py uses).
# See https://console.groq.com/docs/deprecations and .../docs/models.
LLM_MODEL=openai/gpt-oss-120b
LLM_ENRICH_BUDGET_PER_RUN=20
LLM_COMPARE_BUDGET_PER_RUN=10

# --- API -------------------------------------------------------------------
# Comma-separated origins allowed by CORS. Vercel URL goes here in prod.
CORS_ORIGINS=http://localhost:5173

# --- Kill switch -----------------------------------------------------------
# Set to `false` to short-circuit the ingestion orchestrator (still records
# an ingestion_runs row with status=skipped). Useful during incidents.
INGESTION_ENABLED=true
