# NewsLens backend — copy to .env and fill in.
# .env is git-ignored; never commit real credentials.

# --- Database (Neon) -------------------------------------------------------
# Use the `dev` branch URL locally; `prod` branch is only set on Render.
# Include ?sslmode=require for Neon.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# --- LLM (Groq) ------------------------------------------------------------
GROQ_API_KEY=
# Exact model string used for every enrich/compare call; recorded on each
# analysis_runs row for reproducibility.
LLM_MODEL=llama-3.1-70b-versatile

# --- API -------------------------------------------------------------------
# Comma-separated origins allowed by CORS. Vercel URL goes here in prod.
CORS_ORIGINS=http://localhost:5173

# --- Kill switch -----------------------------------------------------------
# Set to `false` to short-circuit the ingestion orchestrator (still records
# an ingestion_runs row with status=skipped). Useful during incidents.
INGESTION_ENABLED=true
